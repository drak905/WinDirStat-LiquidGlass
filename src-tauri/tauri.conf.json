{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinDirStat Liquid Glass",
  "version": "0.1.0",
  "identifier": "org.windirstat.liquidglass",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../src-ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../src-ui"
    },
    "frontendDist": "../src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinDirStat Liquid Glass",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "scrollBarStyle": "fluentOverlay",
        "windowEffects": {
          "effects": ["acrylic", "mica"],
          "state": "active",
          "color": "#1216206E"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
